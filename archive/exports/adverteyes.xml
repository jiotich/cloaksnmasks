                                media_hash = db.insert_media_return_hash(media_name, media_bytes)
                            medias.append(media_name)
                            hashes[media_name] = media_hash
                        db.insert_advert(pk_advertiser, collation, query, medias, hashes)

                    case "cards":
                        medias = []
                        hashes = {}
                        for card in cards:
